{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        // No composite: nothing runs tsc -b; per-package --noEmit checks must
        // not demand portable declaration names across pnpm peer layouts.
        // rootDir/include mirror packages/infrastructure so backend files can
        // import @app/core use cases (hexagonal delegation).
        "rootDir": "../..",
        "outDir": "dist",
        "noEmit": false,
        "allowJs": true,
        "checkJs": false
    },
    "include": [
        "convex/**/*",
        "../core/src/**/*",
        "../core/shared/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
