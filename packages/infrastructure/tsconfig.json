{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    // No composite: nothing runs tsc -b; per-package --noEmit checks must
    // not demand portable declaration names across pnpm peer layouts
    // (better-auth deep types break TS2742 after any peer reshuffle).
    "noEmit": false,
    "rootDir": "../.."
  },
  "include": [
    "src/**/*",
    "../core/src/**/*", "../core/shared/**/*",
    "../convex/convex/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}