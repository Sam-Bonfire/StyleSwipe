{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "eslint.config.mjs",
    "tsconfig.base.json",
    ".prettierrc",
    "pnpm-workspace.yaml"
  ],
  "globalEnv": [
    "EXPO_PUBLIC_*",
    "VITE_*",
    "APP_ENV",
    "CONVEX_URL",
    "EXPO_PUBLIC_CONSUMER_APP_CONVEX_URL",
    "EXPO_PUBLIC_CONSUMER_APP_CONVEX_SITE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "outputs": []
    },
    "web": {
      "cache": false,
      "persistent": true
    }
  }
}