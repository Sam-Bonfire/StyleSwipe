{
  "compilerOptions": {
    /* Base Options */
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun", "node"],
    /* Strictness & Quality */
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    /* Path Mapping for Monorepo Contexts */
    "baseUrl": ".",
    "paths": {
      "@app/core/*": ["packages/core/*"],
      "@app/infrastructure/*": ["packages/infrastructure/*"],
      "@app/ui-kit/*": ["packages/ui-kit/*"],
      "@app/convex/*": ["convex/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".expo", ".next"]
}
