{
    "name": "style-swipe-monorepo",
    "version": "0.0.0",
    "private": true,
    "license": "UNLICENSED",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "packageManager": "bun@1.2.23",
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "dev:consumer": "bun run --filter @app/consumer-app dev",
        "dev:consumer:web": "bun run --filter @app/consumer-app web",
        "typecheck:ui": "bun run --filter @app/ui-kit typecheck"
    },
    "devDependencies": {
        "@types/bun": "^1.3.6",
        "@types/node": "^25.0.10",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-hexagonal-architecture": "^1.0.0",
        "eslint-plugin-perfectionist": "^3.0.0",
        "turbo": "^1.10.0",
        "typescript": "^5.0.0",
        "typescript-eslint": "^8.0.0"
    },
    "overrides": {
        "fsevents": "npm:empty-npm-package@1.0.0"
    },
    "resolutions": {
        "fsevents": "npm:empty-npm-package@1.0.0",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "eslint": "^9.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "@typescript-eslint/utils": "^8.0.0"
    }
}