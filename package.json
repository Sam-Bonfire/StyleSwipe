{
  "name": "style-swipe-monorepo",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "NODE_OPTIONS='--max-old-space-size=4096' turbo run lint",
    "test": "turbo run test",
    "prepare": "bun -e \"const fs = require('fs'); if (fs.existsSync('bin/setup-hooks.ts')) { require('child_process').execSync('bun bin/setup-hooks.ts', { stdio: 'inherit' }); }\"",
    "postinstall": "bun run bin/fix-lightningcss.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@convex-dev/better-auth": "^0.12.5",
    "@esbuild/linux-x64": "0.27.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.61.1",
    "@rollup/rollup-linux-x64-gnu": "^4.56.0",
    "@types/bun": "^1.3.6",
    "@types/node": "^25.0.10",
    "convex": "^1.42.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-hexagonal-architecture": "^1.0.0",
    "eslint-plugin-perfectionist": "^3.0.0",
    "globals": "^16.5.0",
    "lightningcss-linux-x64-gnu": "1.33.0",
    "turbo": "^2.10.5",
    "turbo-linux-64": "^2.8.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "fsevents": "npm:empty-npm-package@1.0.0",
    "detect-libc": "^2.0.3",
    "@xenova/transformers": {
      "sharp": "^0.33.5"
    },
    "esbuild": "0.27.0"
  },
  "resolutions": {
    "fsevents": "npm:empty-npm-package@1.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-reanimated": "4.5.0",
    "eslint": "^9.0.0",
    "esbuild": "0.27.0",
    "sharp": "^0.33.5",
    "@xenova/transformers/sharp": "^0.33.5",
    "detect-libc": "^2.0.3",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/utils": "^8.0.0",
    "@tamagui/core": "2.0.0-rc.26",
    "tamagui": "2.0.0-rc.26",
    "@tamagui/lucide-icons": "2.0.0-rc.26",
    "@tamagui/animations-react-native": "2.0.0-rc.26",
    "@tamagui/linear-gradient": "2.0.0-rc.26",
    "@tamagui/shorthands": "2.0.0-rc.26",
    "@tamagui/themes": "2.0.0-rc.26"
  },
  "optionalDependencies": {
    "lightningcss-win32-x64-msvc": "1.33.0"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "patchedDependencies": {
    "onnxruntime-react-native@1.24.3": "patches/onnxruntime-react-native@1.24.3.patch",
    "expo-modules-core@57.0.8": "patches/expo-modules-core@57.0.8.patch"
  }
}
