{
    "manifest_version": 3,
    "name": "StyleSwipe Scraper",
    "version": "1.0.0",
    "action": {
        "default_popup": "index.html"
    },
    "background": {
        "service_worker": "src/background.ts",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.myntra.com/*"
            ],
            "js": [
                "src/content.ts"
            ]
        }
    ],
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "https://*.convex.cloud/*"
    ]
}