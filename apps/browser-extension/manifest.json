{
  "manifest_version": 3,
  "name": "StyleSwipe Scraper",
  "version": "1.0.0",
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "assets/favicon/icon-16.png",
      "32": "assets/favicon/icon-32.png",
      "48": "assets/favicon/icon-48.png",
      "128": "assets/favicon/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/favicon/icon-16.png",
    "32": "assets/favicon/icon-32.png",
    "48": "assets/favicon/icon-48.png",
    "128": "assets/favicon/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.myntra.com/*"
      ],
      "js": [
        "src/content.ts"
      ]
    },
    {
      "matches": [
        "https://www.myntra.com/*"
      ],
      "js": [
        "src/main_world.ts"
      ],
      "world": "MAIN"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://*.convex.cloud/*",
    "http://localhost/*"
  ]
}