# Stage 1: Builder
FROM oven/bun:1-alpine AS builder

WORKDIR /app

# Install turbo globally
RUN bun add -g turbo

# Prune the workspace to only include admin-panel and its dependencies
COPY . .
RUN turbo prune @app/admin-panel --docker

# Stage 2: Installer & Builder
# Metro bundler requires Node.js runtime (incompatible with Bun's shim resolution)
FROM node:20-alpine AS installer
WORKDIR /app

# Install bun for dependency management
RUN npm install -g bun

# Add dependencies
COPY --from=builder /app/out/json/ .
COPY --from=builder /app/out/bun.lock ./bun.lock
COPY --from=builder /app/tsconfig.base.json ./tsconfig.base.json
COPY --from=builder /app/bin ./bin
RUN bun install

# Copy source code and global assets
COPY --from=builder /app/out/full/ .
COPY --from=builder /app/assets ./assets

# Inject env vars for Expo (generated by CI or `cp .env.local .env.production` locally)
COPY .env.production apps/admin-panel/.env
RUN cd apps/admin-panel && npx expo export -p web

# Stage 3: Runner
FROM nginx:alpine-slim AS runner

# Copy nginx config
COPY apps/admin-panel/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets
# Expo export output directory is usually 'dist' for web
COPY --from=installer /app/apps/admin-panel/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
