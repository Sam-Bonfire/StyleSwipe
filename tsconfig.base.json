{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "lib": [
            "ESNext",
            "DOM",
            "DOM.Iterable"
        ],
        "types": [
            "bun",
            "node"
        ],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noImplicitReturns": false,
        "noImplicitAny": false,
        "allowSyntheticDefaultImports": true,
        "rootDir": "./",
        "paths": {
            "@app/core": ["./packages/core/src"],
            "@app/infrastructure": ["./packages/infrastructure/src"],
            "@app/ui-kit": ["./packages/ui-kit"],
            "@app/convex": ["./packages/convex/convex"],
            "@app/logger": ["./packages/logger/src"]
        },

    },
    "exclude": [
        "node_modules",
        "dist",
        ".expo",
        ".next"
    ]
}