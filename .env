# ==========================================
# StyleSwipe Environment Variables
# ==========================================
# This file serves as the base structure. 
# Do not place secrets here. Use .env.local for local overrides.

# ------------------------------------------
# Convex Backend
# ------------------------------------------
# Core Convex URLs (Set in .env.local)


# ------------------------------------------
# Expo Public Consumer App
# ------------------------------------------
EXPO_PUBLIC_CONSUMER_APP_CONVEX_URL=${CONVEX_URL}
EXPO_PUBLIC_CONSUMER_APP_CONVEX_SITE_URL=${CONVEX_SITE_URL}

# ------------------------------------------
# ML Models (Scraper / Infra)
# ------------------------------------------
PRODUCT_EMBEDDING_MODEL_NAME=Xenova/bge-small-en-v1.5

# ------------------------------------------
# Expo Public AI & SLM Settings
# ------------------------------------------
EXPO_PUBLIC_PRODUCT_EMBEDDING_MODEL_NAME=${PRODUCT_EMBEDDING_MODEL_NAME}
EXPO_PUBLIC_SLM_MODEL_URL=https://huggingface.co/${PRODUCT_EMBEDDING_MODEL_NAME}/resolve/main/onnx/model_quantized.onnx
EXPO_PUBLIC_SLM_TOKENIZER_URL=https://huggingface.co/${PRODUCT_EMBEDDING_MODEL_NAME}/resolve/main/tokenizer.json
EXPO_PUBLIC_SLM_TOKENIZER_CONFIG_URL=https://huggingface.co/${PRODUCT_EMBEDDING_MODEL_NAME}/resolve/main/tokenizer_config.json
EXPO_PUBLIC_LEARNING_RATE_ALPHA=0.1
EXPO_PUBLIC_PENALTY_RATE_BETA=0.05

# ------------------------------------------
# Scraper Service
# ------------------------------------------
VITE_CONVEX_URL=${CONVEX_URL}
SCRAPER_API_PORT=3001
SCRAPER_MODE=BROWSER
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
HEADLESS=true

# Scraper Proxy Config
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# ------------------------------------------
# Development Server Settings
# ------------------------------------------
# Suppress automatic browser window launching on startup
BROWSER=none